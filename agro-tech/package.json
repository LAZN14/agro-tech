{
  "name": "agro-tech",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:pages": "tsc && vite build && node scripts/postbuild-pages.mjs",
    "preview": "vite preview",
    "deploy:surge": "npm run build && node scripts/prepare-surge-deploy.mjs",
    "deploy:netlify": "npm run deploy:surge && cd dist && npx netlify-cli deploy --dir=. --prod --no-build --allow-anonymous"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1"
  }
}
